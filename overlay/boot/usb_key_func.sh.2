pivotMode=false
pkd=`dirname $0`
cd $pkd ; pkd=`pwd` ; cd - > /dev/null
pkp=`df -h $pkd | grep $pkd | cut -d " " -f1`

/sbin/ifconfig egiga0 up
/sbin/ifconfig egiga1 up
/sbin/ifconfig eth0 up
/sbin/ifconfig eth1 up


cd /
$pivotMode || telnetd -l /bin/sh

/sbin/dhcpcd egiga0
#/sbin/dhcpcd egiga1
/sbin/dhcpcd eth0
#/sbin/dhcpcd eth1


mkdir /newroot
mount -o noatime,nodiratime,errors=remount-ro ${pkp/1/2} /newroot
mkdir -p /newroot/oldroot
cp -a /dev/. /newroot/dev/

if [ ! -e /newroot/etc/.zy-first.done ]; then
  mkdir -p /usr/local
  mount -o bind /newroot/usr/local /usr/local
  echo 1 > /proc/mcu_wdt
  /usr/local/bin/zy-fw-get-bin
  umount /usr/local
fi


cd /newroot

${pkd}/debroot.sh

#/bin/sh

echo "sleep 1" > /tmp/umount-usbkey.sh
echo "umount ${pkd}" >> /tmp/umount-usbkey.sh
/bin/sh /tmp/umount-usbkey.sh &

exit 0
