#!/bin/sh

if [ -e /tmp/.dru-boot.done ]; then
  exit 0
fi

if [ ! -e /dev/gpio ]; then
  # Create device node for gpio control
  #mknod -m 644 /dev/gpio c  0
  mknod -m 644 /dev/gpio c 253 0
fi

if [ ! -e /etc/.zy-first.done ]; then
  /usr/local/bin/zy-nand-get

  if command -v omv-confdbadm >/dev/null 2>&1 || command -v omv-initsystem >/dev/null 2>&1; then
    if command -v omv-initsystem >/dev/null 2>&1; then
      omv-initsystem
    else
      omv-confdbadm populate
    fi
    usermod -a -G openmediavault-admin admin 2>/dev/null || true
    dpkg-reconfigure openmediavault-lvm2 2>/dev/null || true

    /usr/bin/salt-call --local saltutil.clear_cache 2>/dev/null || true
    omv-salt stage run prepare 2>/dev/null || true
  fi

  # Generate root client SSH keypair on first boot if missing
  if [ ! -f /root/.ssh/id_ed25519 ] && [ ! -f /root/.ssh/id_rsa ]; then
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519 -C "root@$(hostname)" >/dev/null 2>&1 || true
    ssh-keygen -t rsa -b 3072 -N "" -f /root/.ssh/id_rsa -C "root@$(hostname)" >/dev/null 2>&1 || true
    chmod 600 /root/.ssh/id_* 2>/dev/null || true
    chmod 644 /root/.ssh/*.pub 2>/dev/null || true
  fi

  # AUTO-SYNC KERNEL: If booted with an older NAND kernel lacking matching modules
  if [ ! -d "/lib/modules/$(uname -r)" ] && [ -x /usr/local/bin/zy-kernel2-write ] && [ -f /boot/uImage ]; then
    /usr/local/bin/zy-kernel2-write >/dev/null 2>&1 || true
    BUZZER_BIN=$(command -v buzzerc || command -v /firmware/bin/buzzerc || command -v /usr/local/bin/buzzerc || command -v /usr/sbin/buzzerc || true)
    [ -n "$BUZZER_BIN" ] && "$BUZZER_BIN" -t 2 2>/dev/null || true
    touch /etc/.zy-first.done
    sync
    sleep 2
    reboot -f || true
    exit 0
  fi

  touch /etc/.zy-first.done
fi

if command -v omv-mkconf >/dev/null 2>&1; then
  omv-mkconf issue 2>/dev/null || true
fi

ipbin=`which ip || true`
defgw=`grep -m1 'gateway4: ' /etc/netplan/*.yaml | cut -d ':' -f 3- | tr -d ' '`
if [ "X${defgw}" = "X" ]; then
  defgw=`cat /etc/netplan/*.yaml | grep -A5 'routes:' | grep -A1 'to: 0.0.0.0/0' | grep -m1 'via:' | cut -d ':' -f 2 | cut -d ' ' -f 2`
fi
defns=`cat /etc/netplan/*.yaml | grep -A3 'nameservers:' | grep -A1 'addresses:' | grep -m1 '\- ' | cut -d '-' -f 2- | cut -d ' ' -f 2`

if [ "X${ipbin}" != "X" -a "X${defgw}" != "X" ]; then
  ip route add default via ${defgw}
fi

if [ -e /etc/systemd/resolved.conf -a "X${defns}" != "X" ]; then
  if grep -q -E '^#DNS=' /etc/systemd/resolved.conf ; then
    sed -i s/'^#DNS=.*'/'DNS='${defns}/g /etc/systemd/resolved.conf
    systemctl restart systemd-resolved
  fi
fi

BUZZER_BIN=$(command -v buzzerc || command -v /firmware/bin/buzzerc || command -v /usr/local/bin/buzzerc || command -v /sbin/buzzerc || true)
[ -n "$BUZZER_BIN" ] && "$BUZZER_BIN" -t 1 2>/dev/null || true

LED_BIN=$(command -v setLED || command -v /firmware/bin/setLED || command -v /usr/local/bin/setLED || command -v /sbin/setLED || true)
[ -n "$LED_BIN" ] && "$LED_BIN" SYS OFF 2>/dev/null || true

touch /tmp/.dru-boot.done

