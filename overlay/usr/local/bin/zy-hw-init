#!/bin/sh

# Stop/reset MCU hardware watchdog timer immediately
# (Zyxel Comcerto MCU resets CPU every 60s if not reset/stopped)
if [ -e /proc/mcu_wdt ]; then
    echo 1 > /proc/mcu_wdt
fi

if [ -f /etc/zy-profile ]; then
    . /etc/zy-profile
fi

# Generate fresh SSH host keys on first boot if missing
if [ ! -f /etc/ssh/ssh_host_ed25519_key ] && [ ! -f /etc/ssh/ssh_host_rsa_key ]; then
    echo "=== [zy-hw-init] Generating fresh SSH host keys ===" > /dev/console 2>/dev/null || true
    ssh-keygen -A >/dev/null 2>&1 || true
fi

# Generate root client SSH keypair on first boot if missing
if [ ! -f /root/.ssh/id_ed25519 ] && [ ! -f /root/.ssh/id_rsa ]; then
    echo "=== [zy-hw-init] Generating fresh root SSH client keys ===" > /dev/console 2>/dev/null || true
    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519 -C "root@$(hostname)" >/dev/null 2>&1 || true
    ssh-keygen -t rsa -b 3072 -N "" -f /root/.ssh/id_rsa -C "root@$(hostname)" >/dev/null 2>&1 || true
    chmod 600 /root/.ssh/id_* 2>/dev/null || true
    chmod 644 /root/.ssh/*.pub 2>/dev/null || true
fi

# Ensure /dev/gpio node exists
if [ ! -e /dev/gpio ]; then
    mknod -m 644 /dev/gpio c 253 0 2>/dev/null || true
fi

# Load Comcerto 2000 Packet Forwarding Engine (PFE) network driver
if ! lsmod 2>/dev/null | grep -q '^pfe '; then
    modprobe pfe lro_mode=1 tx_qos=0 2>/dev/null || \
    insmod "/lib/modules/$(uname -r)/kernel/drivers/pfe_ctrl/pfe.ko" lro_mode=1 tx_qos=0 2>/dev/null || \
    insmod "/usr/lib/modules/$(uname -r)/kernel/drivers/pfe_ctrl/pfe.ko" lro_mode=1 tx_qos=0 2>/dev/null || true
fi
# Kernel / VM sysctl performance tunings
echo "32769 42768" > /proc/sys/net/ipv4/ip_local_port_range 2>/dev/null || true
echo 8192 > /proc/sys/vm/min_free_kbytes 2>/dev/null || true
echo 100 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true
echo 5 > /proc/sys/vm/dirty_background_ratio 2>/dev/null || true
echo 10 > /proc/sys/vm/dirty_ratio 2>/dev/null || true
echo "1 1" > /proc/sys/vm/lowmem_reserve_ratio 2>/dev/null || true
echo "512 87380 2048000" > /proc/sys/net/ipv4/tcp_rmem 2>/dev/null || true
echo "512 65536 2048000" > /proc/sys/net/ipv4/tcp_wmem 2>/dev/null || true
echo 524288 > /proc/sys/net/core/rmem_max 2>/dev/null || true
echo 524288 > /proc/sys/net/core/wmem_max 2>/dev/null || true

# Wait briefly for PFE network interfaces to initialize
for i in 1 2 3; do
    if ip link show wan0 >/dev/null 2>&1 || ip link show eth0 >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# Rename PFE interfaces to standard Linux names
# wan0 -> eth0
if ip link show dev wan0 >/dev/null 2>&1; then
    ip link set dev wan0 down 2>/dev/null || true
    ip link set dev wan0 name eth0 2>/dev/null || true
fi

# lan0 -> eth1
if ip link show dev lan0 >/dev/null 2>&1; then
    ip link set dev lan0 down 2>/dev/null || true
    ip link set dev lan0 name eth1 2>/dev/null || true
fi

# Assign hardware MAC addresses from NAND MRD if available
MRD_BIN=""
if [ -x "/firmware/sbin/mrd_mac" ]; then
    MRD_BIN="/firmware/sbin/mrd_mac"
elif [ -x "/usr/local/bin/mrd_mac" ]; then
    MRD_BIN="/usr/local/bin/mrd_mac"
elif [ -x "/usr/sbin/mrd_mac" ]; then
    MRD_BIN="/usr/sbin/mrd_mac"
fi

if ip link show dev eth0 >/dev/null 2>&1; then
    if [ -n "$MRD_BIN" ]; then
        MAC0=$("$MRD_BIN" eth0 2>/dev/null || true)
        if echo "$MAC0" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
            ip link set dev eth0 address "$MAC0" 2>/dev/null || true
        fi
    fi
    ip link set dev eth0 up 2>/dev/null || true
fi

if ip link show dev eth1 >/dev/null 2>&1; then
    if [ -n "$MRD_BIN" ]; then
        MAC1=$("$MRD_BIN" eth1 2>/dev/null || true)
        if echo "$MAC1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
            ip link set dev eth1 address "$MAC1" 2>/dev/null || true
        fi
    fi
    ip link set dev eth1 up 2>/dev/null || true
fi

# Set RTC time to system time
RTC_BIN=""
if [ -x "/firmware/sbin/rtcAccess" ]; then
    RTC_BIN="/firmware/sbin/rtcAccess"
elif [ -x "/usr/local/bin/rtcAccess" ]; then
    RTC_BIN="/usr/local/bin/rtcAccess"
elif [ -x "/usr/sbin/rtcAccess" ]; then
    RTC_BIN="/usr/sbin/rtcAccess"
fi

if [ -n "$RTC_BIN" ]; then
    "$RTC_BIN" init 2>/dev/null || true
    "$RTC_BIN" rtctosys 2>/dev/null || true
fi

exit 0
